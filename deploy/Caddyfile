# DOMAIN comes from docker-compose (.env). Caddy gets HTTPS certificates automatically.
{$DOMAIN:localhost} {
	encode zstd gzip

	handle /socket.io/* {
		reverse_proxy server:8787
	}
	handle /api/* {
		reverse_proxy server:8787
	}
	handle {
		root * /srv
		@assets path /assets/* /textures/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
